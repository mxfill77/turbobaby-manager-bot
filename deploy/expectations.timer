[Unit]
Description=Запуск слоя ожиданий каждые 10 минут (ярус 2)

[Timer]
# ПЕРИОД НАБЛЮДАТЕЛЯ НЕ МОЖЕТ БЫТЬ БОЛЬШЕ ПОРОГА ОЖИДАНИЯ — иначе порог фиктивен. Пороги слоя:
# О2 = 10 мин, О1 = 30 мин; отсюда 10 минут, и отсюда же слой не мог жить на invariants.timer
# (он ходит раз в 4 часа — годится только для дрейфа прода).
OnBootSec=5min
OnUnitActiveSec=10min
# сервер спал/был выключен в момент срабатывания — догнать пропущенный прогон
Persistent=true
Unit=expectations.service

[Install]
WantedBy=timers.target
